<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Corner's shared web security core: headers and CSP, sessions and Supabase sign-in, origin
       checks, environments. Referenced by each site as a git submodule. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheCorner.Web.Tests" />
  </ItemGroup>

</Project>
